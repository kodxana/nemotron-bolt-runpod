{
  "input": {
    "openai_route": "/v1/chat/completions",
    "openai_input": {
      "messages": [
        {
          "role": "user",
          "content": "Explain binary search in three sentences."
        }
      ],
      "max_tokens": 256,
      "temperature": 1.0,
      "top_p": 0.95,
      "chat_template_kwargs": {
        "enable_thinking": false
      },
      "model": "nemotron-bolt"
    }
  }
}
